{
  "name": "zhijiao-messenger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "start": "node runtime/index.mjs",
    "dev": "node scripts/dev.mjs",
    "desktop": "node scripts/desktop.mjs launch",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "relay": "node relay/server.mjs",
    "client": "node client/index.mjs",
    "desktop:check": "node scripts/desktop.mjs check",
    "desktop:setup": "node scripts/desktop.mjs setup",
    "desktop:update": "node scripts/desktop.mjs update",
    "export:projects": "node scripts/export-projects.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "electron": "^40.0.0",
    "@playwright/test": "^1.51.0"
  }
}
